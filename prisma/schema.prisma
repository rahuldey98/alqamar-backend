generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  email     String?
  password  String
  role      UserRole
  gender    Gender?
  age       Int?
  status    Status   @default(ACTIVE)
  // TODO: remove User.meetLink once all clients read from Teacher.meetLink. Kept here as a backward-compatible mirror.
  meetLink  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher     Teacher?
  student     Student?
  attendances Attendance[]
}

model Teacher {
  userId   Int     @id
  user     User    @relation(fields: [userId], references: [id])
  meetLink String?

  taughtClasses   Class[]   @relation("TeacherClasses")
  students        Student[] @relation("TeacherStudents")
  taughtClassesV2 ClassV2[] @relation("TeacherClassesV2")
}

model Student {
  userId    Int       @id
  user      User      @relation(fields: [userId], references: [id])
  feesDate  DateTime?
  courseId  Int?
  course    Course?   @relation(fields: [courseId], references: [id])
  classId   Int?
  class     Class?    @relation("ClassStudents", fields: [classId], references: [id])
  teacherId Int?
  teacher   Teacher?  @relation("TeacherStudents", fields: [teacherId], references: [userId])
  classesV2 ClassV2[] @relation("StudentClassesV2")
}

model Course {
  id             Int       @id @default(autoincrement())
  title          String
  enTitle        String?
  durationMonths Int
  status         Status    @default(ACTIVE)
  students       Student[]
}

model Class {
  id        Int       @id @default(autoincrement())
  teacherId Int
  teacher   Teacher   @relation("TeacherClasses", fields: [teacherId], references: [userId])
  meetLink  String?
  status    Status    @default(ACTIVE)
  startDate DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  schedules   ClassSchedule[]
  students    Student[]       @relation("ClassStudents")
  attendances Attendance[]
}

model ClassSchedule {
  id        Int       @id @default(autoincrement())
  classId   Int
  class     Class     @relation(fields: [classId], references: [id])
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  status    Status    @default(ACTIVE)
}

model Attendance {
  id        Int      @id @default(autoincrement())
  classId   Int
  class     Class    @relation(fields: [classId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  date      String
  createdAt DateTime @default(now())

  @@unique([classId, userId, date])
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum Status {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

model ClassV2 {
  id Int @id @default(autoincrement())

  teacherId Int
  teacher   Teacher @relation("TeacherClassesV2", fields: [teacherId], references: [userId], onDelete: Cascade)

  studentId Int
  student   Student @relation("StudentClassesV2", fields: [studentId], references: [userId], onDelete: Cascade)

  date      String  @db.VarChar(10) // "YYYY-MM-DD"
  startTime String  @db.VarChar(5) // "HH:MM" 24-hr
  endTime   String  @db.VarChar(5) // "HH:MM" 24-hr
  meetLink  String?
  status    Status  @default(ACTIVE)

  // Embedded Attendance
  teacherAttended  Boolean               @default(false)
  studentAttended  Boolean               @default(false)
  teacherJoinedAt  DateTime?
  studentJoinedAt  DateTime?
  attendanceStatus ClassAttendanceStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite indexes for high-throughput queries
  @@index([date, status])
  @@index([date, teacherId])
  @@index([date, studentId])
  @@index([status, endTime])
  @@index([teacherId, endTime])
  @@index([studentId, endTime])
  @@map("class_v2")
}

enum ClassAttendanceStatus {
  PENDING
  TEACHER_PRESENT
  STUDENT_PRESENT
  ALL_PRESENT
  ABSENT
}
